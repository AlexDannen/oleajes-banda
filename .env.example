# Contraseña para entrar a /admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Cadena aleatoria larga usada para firmar la sesión del administrador
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Vercel: conecta una base Upstash Redis y usa las variables que entrega
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Docker/desarrollo local: archivo persistente (monta /app/data como volumen)
ANALYTICS_DATA_FILE=./data/analytics.json
ANALYTICS_TIME_ZONE=America/Santiago
